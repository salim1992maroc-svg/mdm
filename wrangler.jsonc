{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-miniapp",
  "main": "index.js",
  "compatibility_date": "2026-09-16",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-miniapp-db",
      "database_id": "PUT-YOUR-D1-DATABASE-ID-HERE"
    }
  ]
}
